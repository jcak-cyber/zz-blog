# 复制为项目根目录 .env 后填写（不要提交到 Git）
# cp .env.example .env

POSTGRES_USER=zzblog
POSTGRES_PASSWORD=请改成强密码
POSTGRES_DB=zzblog

# 用 openssl rand -hex 32 生成
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
IMPORT_TOKEN=

# 公网访问时改成你的站点地址
CORS_ORIGIN=http://121.40.40.46:3000
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_SITE_URL=http://121.40.40.46:3000

# 用公网 IP + HTTP 访问时保持 false；配置 HTTPS 后改为 true
COOKIE_SECURE=false

# 部署方式（推荐 build）：
#   build = 服务器 docker compose 构建（走 Dockerfile 里的 npmmirror，国内稳）
#   pull  = 拉 GHCR 镜像（跨境易超时；DaoCloud 加速不支持个人镜像白名单）
DEPLOY_MODE=build
GHCR_OWNER=jcak-cyber
# pull 模式才需要：
# GHCR_REGISTRY=ghcr.io
